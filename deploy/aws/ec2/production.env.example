# Copy into the host secret store as /var/www/gownsea/shared/.env.
# Never commit the populated file. Keep APP_KEY and the backup key separate.
APP_NAME="GOWNSEA Operations"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://REPLACE_WITH_GOWNSEA_DOMAIN
APP_TIMEZONE=Africa/Nairobi
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

# Keep app-managed private uploads and receipts on the host's encrypted,
# persistent EBS volume. Encrypted archives are mirrored to the private S3 bucket.
FILESYSTEM_DISK=local
GOWNSEA_BACKUP_DIRECTORY=/var/lib/gownsea/backups
GOWNSEA_BACKUP_RETENTION_DAYS=30
GOWNSEA_BACKUP_EXTERNAL_DISK=s3
GOWNSEA_BACKUP_EXTERNAL_PREFIX=gownsea-backups
GOWNSEA_BACKUP_ENCRYPTION_KEY=

# Recommended AWS region for a Kenya workload; enable it on the AWS account first.
AWS_DEFAULT_REGION=af-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Do not set AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY on EC2.
# The EC2 instance profile supplies temporary credentials.

MAIL_MAILER=smtp
MAIL_HOST=email-smtp.eu-north-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@gownsea.com
MAIL_FROM_NAME="${APP_NAME}"

DARAJA_ENABLED=false
DARAJA_ENVIRONMENT=sandbox
ONFON_SMS_CLIENT_ID=
ONFON_SMS_API_KEY=
ONFON_SMS_ACCESS_KEY=
ONFON_SMS_SENDER_ID=GOWNSEA

# Set enabled only after eTIMS onboarding, approved VSCU/OSCU setup and sandbox certification.
ETIMS_ENABLED=false
ETIMS_PROVIDER=kra_vscu
ETIMS_VSCU_ENDPOINT=
